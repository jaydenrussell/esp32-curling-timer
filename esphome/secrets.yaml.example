# Copy to secrets.yaml (gitignored) and fill in.
#
# Encryption keys are 32 random bytes, base64 encoded - generate with:
#   openssl rand -base64 32
# The same value must be given to Home Assistant (API encryption key) or
# to the OTA client, otherwise the connection is rejected.

# Native API encryption key (Home Assistant "encryption key" field).
# The same key encrypts and authenticates over-the-air updates, so it
# is used for both the API and OTA.
curling_timer__encryption_key: "base64-encoded-32-byte-key"

# Wi-Fi network for failover (via C6 co-processor) and OTA
wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Hotspot the device creates when it can't reach a network
ap_password: "setup-mode-password"

# Web UI login (username is fixed as "admin" in the YAML; at least
# 6 characters, the web editor refuses to start with a shorter one)
web_password: "web-login-password"
